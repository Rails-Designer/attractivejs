<article class="content">
  <h1>
    <%= link_to "Actions", article_path("actions") %> / <%= @resource.title %>
  </h1>

  <p>
    <%= @resource.description %>
  </p>

  <% if @resource.metadata.note.present? %>
    <%= markdownify @resource.metadata.note %>
  <% end %>

  <p>
    <%= @resource.metadata.alias %>
  </p>

  <dl>
    <%= @resource.metadata.options %>
  </dl>
</article>

<div @action="livePreview:mounted" @target="live-preview-example" class="action-preview">
  <div class="code">
    <%= markdownify @resource.code_preview %>
  </div>

  <div class="example" id="live-preview-example">
    <%== @resource.content %>
  </div>
</div>
