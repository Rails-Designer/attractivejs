<article class="content">
  <h1>
    <%= link_to "Actions", article_path("actions") %> / <%= @resource.title %>
  </h1>

  <p>
    <%= @resource.description %>
  </p>

  <%= markdownify @resource.metadata.note if @resource.metadata.note.present? %>

  <%= tag.p do %>
    <strong>Aliases:</strong>

    <%= @resource.metadata.aliases.to_sentence %>
  <% end if @resource.metadata.aliases.present? %>
</article>

<div @action="livePreview:mounted" @target="live-preview-example" class="action-preview">
  <div class="code">
    <%= markdownify @resource.code_preview %>
  </div>

  <div class="example" id="live-preview-example">
    <%== @resource.content %>
  </div>
</div>
