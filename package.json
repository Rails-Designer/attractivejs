{
  "name": "attractivejs",
  "version": "1.0.0-alpha.4",
  "type": "module",
  "description": "A light-weight library for declarative DOM actions using data attributes",
  "scripts": {
    "build": "rolldown -c",
    "dev": "npm-run-all --parallel dev:*",
    "dev:watch": "rolldown -c -w",
    "dev:serve": "npx http-server . -p 8080",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ci": "pnpm lint && pnpm format:check && pnpm test",
    "docs": "cd ./docs/ && bin/dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build",
    "release": "bash scripts/release.sh"
  },
  "author": "Rails Designer",
  "homepage": "https://attractivejs.railsdesigner.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rails-designer/attractivejs.git"
  },
  "bugs": {
    "url": "https://github.com/rails-designer/attractivejs/issues"
  },
  "module": "dist/attractive.js",
  "main": "dist/attractive.min.js",
  "exports": {
    ".": {
      "import": "./dist/attractive.js",
      "require": "./dist/attractive.min.js"
    },
    "./core": {
      "import": "./dist/attractive.core.js"
    },
    "./actions": {
      "import": "./dist/actions/index.js"
    },
    "./actions/attribute": {
      "import": "./dist/actions/attribute.js"
    },
    "./actions/class": {
      "import": "./dist/actions/class.js"
    },
    "./actions/clipboard": {
      "import": "./dist/actions/clipboard.js"
    },
    "./actions/confirm": {
      "import": "./dist/actions/confirm.js"
    },
    "./actions/data-attribute": {
      "import": "./dist/actions/data-attribute.js"
    },
    "./actions/dialog": {
      "import": "./dist/actions/dialog.js"
    },
    "./actions/focus": {
      "import": "./dist/actions/focus.js"
    },
    "./actions/inline": {
      "import": "./dist/actions/inline.js"
    },
    "./actions/form": {
      "import": "./dist/actions/form.js"
    },
    "./actions/reload": {
      "import": "./dist/actions/reload.js"
    },
    "./actions/request": {
      "import": "./dist/actions/request.js"
    },
    "./actions/scroll-to": {
      "import": "./dist/actions/scroll-to.js"
    },
    "./actions/style": {
      "import": "./dist/actions/style.js"
    },
    "./keyboard": {
      "import": "./dist/keyboard.js"
    },
    "./reactive": {
      "import": "./dist/reactive.js"
    },
    "./attract": {
      "import": "./dist/attract.js"
    },
    "./validate": {
      "import": "./dist/validate.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "http-server": "^14.1.1",
    "jsdom": "^27.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rolldown": "^1.1.4",
    "vitest": "^3.2.4"
  }
}
