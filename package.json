{
  "name": "attractivejs",
  "version": "0.12.0",
  "description": "A light-weight library for declarative DOM actions using data attributes",
  "scripts": {
    "build": "rollup -c",
    "dev": "npm-run-all --parallel dev:*",
    "dev:watch": "rollup -c -w",
    "dev:serve": "npx http-server . -p 8080",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ci": "npm run lint && npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "release": "bash scripts/release.sh"
  },
  "author": "Rails Designer",
  "homepage": "https://attractivejs.railsdesigner.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rails-designer/attractivejs.git"
  },
  "bugs": {
    "url": "https://github.com/rails-designer/attractivejs/issues"
  },
  "module": "dist/attractive.js",
  "main": "dist/attractive.min.js",
  "exports": {
    ".": {
      "import": "./dist/attractive.js",
      "require": "./dist/attractive.min.js"
    },
    "./actions": {
      "import": "./src/actions/index.js"
    },
    "./actions/attribute": {
      "import": "./src/actions/attribute.js"
    },
    "./actions/class": {
      "import": "./src/actions/class.js"
    },
    "./actions/clipboard": {
      "import": "./src/actions/clipboard.js"
    },
    "./actions/confirm": {
      "import": "./src/actions/confirm.js"
    },
    "./actions/data-attribute": {
      "import": "./src/actions/data_attribute.js"
    },
    "./actions/dialog": {
      "import": "./src/actions/dialog.js"
    },
    "./actions/element": {
      "import": "./src/actions/element.js"
    },
    "./actions/focus": {
      "import": "./src/actions/focus.js"
    },
    "./actions/form": {
      "import": "./src/actions/form.js"
    },
    "./actions/intersection": {
      "import": "./src/actions/intersection.js"
    },
    "./actions/reload": {
      "import": "./src/actions/reload.js"
    },
    "./actions/request": {
      "import": "./src/actions/request.js"
    },
    "./actions/scroll-to": {
      "import": "./src/actions/scroll_to.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "http-server": "^14.1.1",
    "jsdom": "^27.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rollup": "^2.79.2",
    "rollup-plugin-terser": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
